#!/bin/sh
#
# QZdesk 桌面自启脚本。放在 S30：排在设备节点与挂载之后、网络之前。
#
# 为什么不是原来的 S99：
#   rcS 按字典序跑 init.d：
#     S01seedrng S01syslogd S02klogd S02sysctl
#     S10udev(设备节点) S20linkmount(oem 挂载) S20urandom S21appinit
#     S40network S49ntp S50sshd S50telnet S50usbdevice(adb)
#     S91smb S99_auto_reboot  <- 原来我就在这后面
#   排在最后等于"等网络、ntp、ssh、smb 全跑完才画第一帧"，屏幕迟迟不亮。
#   挪到 S30 后，挂载一完成就起界面，网络与核心连接在后台并行 —— 上机观感
#   就是开机快了一截。代价是要自己确认 oem 已挂载、/dev/fb0 已就绪，所以下面
#   有 READY_WAIT 就绪等待（等不到也照起，留给界面自己重试）。
#
# 只负责拉起界面进程：核心服务（xiaozhi_linux_rs）由界面按同一目录去找、去拉起、
# 去重启，所以这里不管第二个进程。
#
# 字体、显示与触摸节点都在这里给默认值，要临时换设备节点改这里即可，不必重编程序：
#   QZDESK_FONT   中文 TTF 字体路径
#   QZDESK_FB     framebuffer 节点
#   QZDESK_TOUCH  触摸输入节点
#
DAEMON=/oem/usr/bin/qzdesk_screen
WORKDIR=/oem/usr/bin
LOG=/var/log/qzdesk.log
PIDFILE=/var/run/qzdesk.pid
WIFI_KO=/oem/usr/lib/wifi   # RTL8723BS 驱动模块（镜像里没带时目录不存在，静默跳过）
CAM_KO=/oem/usr/lib/camera  # SC3336 + rkcif/rkisp 驱动模块
WIFI_CONF=${QZDESK_WIFI_PERSIST_CONF:-/userdata/qzdesk/wpa_supplicant.conf}
DEFAULT_WIFI_CONF=${QZDESK_DEFAULT_WIFI_CONF:-/oem/usr/etc/qzdesk/wpa_supplicant.default.conf}
KWS_BIN=/oem/usr/bin/qzdesk-kws # 本地唤醒词进程（NPU KWS，独立进程；没编出来就静默跳过）
KWS_SOCK=/var/run/qzdesk-kws.sock
KWS_PIDFILE=/var/run/qzdesk-kws-child.pid
KWS_SUPERVISOR_PIDFILE=/var/run/qzdesk-kws-supervisor.pid
FW_SRC=/oem/usr/lib/firmware # WiFi 固件（开机补进 /lib/firmware）
READY_WAIT=50           # 就绪等待轮数：50 × 100ms = 5 秒
LOG_MAX=$((512 * 1024)) # 日志超过 512KB 就在启动时截断（免得越写越大拖慢写盘）
MIC_CARD=
MIC_FAILED=0
AUDIO_MUTE_MARKER=/userdata/qzdesk/audio-muted

export QZDESK_FONT=${QZDESK_FONT:-/oem/usr/share/fonts/NanoTikBazHei-Bold.ttf}
export QZDESK_FB=${QZDESK_FB:-/dev/fb0}
export QZDESK_TOUCH=${QZDESK_TOUCH:-/dev/input/event0}
export ALSA_CONFIG_PATH=${ALSA_CONFIG_PATH:-/usr/share/alsa/alsa.conf}
export ALSA_CONFIG_DIR=${ALSA_CONFIG_DIR:-/usr/share/alsa}

# 临时硬静音开关：存在该文件时不打开 ALSA 采集/播放，也不启动本地 KWS。
# 混音器仍会在启动时逐项写为静音，避免上一次异常退出留下可闻输出。
audio_disabled() {
	case "$(printf '%s' "${QZDESK_AUDIO_DISABLED:-0}" | tr 'A-Z' 'a-z')" in
		1|true|yes) return 0 ;;
	esac
	return 1
}

if [ -f "$AUDIO_MUTE_MARKER" ]; then
	export QZDESK_AUDIO_DISABLED=1
fi

# 唤醒词旁路：核心与 qzdesk-kws 用同一个 socket 路径（两边都读这个变量）。
# 不想用唤醒词就把这行注释掉 —— 核心侧就不会建旁路 socket，KWS 进程也起不来。
export QZDESK_KWS_SOCKET=${QZDESK_KWS_SOCKET:-/var/run/qzdesk-kws.sock}
# 唤醒词用哪一套模型（库与模型由进程按这个变量选，不用重编）：
#   mode2（默认）= 唤醒词 "小和小和" + 19 条命令词（打电话给爸爸…）
#   mode1        = 8 条一次性命令词（我要拍照 / 打开关闭热点、录音、屏幕）
export QZDESK_KWS_MODE=${QZDESK_KWS_MODE:-mode2}
# 核心旁路是单声道 24 kHz；mode2 的双麦 BF 算法需要双声道，由 qzdesk-kws 复制。
export QZDESK_KWS_INPUT_CHANNELS=${QZDESK_KWS_INPUT_CHANNELS:-1}
export QZDESK_KWS_INPUT_RATE=${QZDESK_KWS_INPUT_RATE:-24000}
# 低风险麦克风诊断：默认关闭。创建 mic-dump.enable 后，下一次核心启动会
# 把真实左声道和 Speex 处理后的 24 kHz/mono/s16le PCM 写到 /tmp，供拉回
# 本机做频谱与离线识别。PCM 没有文件头，读取参数见 core 日志。
if ! audio_disabled && [ -f /userdata/qzdesk/mic-dump.enable ]; then
	export QZDESK_MIC_RAW_DUMP=${QZDESK_MIC_RAW_DUMP:-/tmp/qzdesk-mic-raw.pcm}
	export QZDESK_MIC_DUMP=${QZDESK_MIC_DUMP:-/tmp/qzdesk-mic-processed.pcm}
fi
export QZDESK_WIFI_PERSIST_CONF=$WIFI_CONF
mkdir -p /userdata/qzdesk
export QZDESK_COMPUTER_CONFIG=${QZDESK_COMPUTER_CONFIG:-/userdata/qzdesk/computer.json}
if [ -r /etc/qzdesk/computer-url ]; then
	export QZDESK_WINDOWS_MCP_URL="$(cat /etc/qzdesk/computer-url)"
fi
if [ -r /etc/qzdesk/computer-token ]; then
	export QZDESK_WINDOWS_MCP_TOKEN="$(cat /etc/qzdesk/computer-token)"
fi

# 本脚本同时装在 rootfs /etc/init.d（rcS 跑）和 oem /oem/usr/etc/init.d（RkLunch 跑），
# 没这个判断时两条路各起一次，两个界面进程抢同一个 framebuffer。
running() {
	# 1) 按 PID 文件判断（正常路径）
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
	fi
	# 2) 兜底：按进程名判断。两个启动脚本（rcS 与 RkLunch）会同时跑，
	#    只看 PID 文件会竞态起两份，两个进程抢 framebuffer/触摸 → 闪屏+误触。
	#    不能 grep ps 输出：通过 adb 执行本脚本时，adb shell 的命令行本身就含有
	#    qzdesk_screen，会把自己误判成界面进程。读取 /proc/PID/comm 只匹配
	#    可执行文件名，不受 shell 参数影响。
	for comm in /proc/[0-9]*/comm; do
		[ -r "$comm" ] || continue
		[ "$(cat "$comm" 2>/dev/null)" = "qzdesk_screen" ] && return 0
	done
	return 1
}

ready() {
	[ -x "$DAEMON" ] && [ -e "$QZDESK_FB" ] && [ -e "$QZDESK_FONT" ]
}

mic_log() {
	mkdir -p /var/log 2>/dev/null
	echo "qzdesk mic: $*" >>"$LOG"
}

find_mic_card() {
	card=0
	while [ "$card" -lt 4 ]; do
		if amixer -c "$card" sget 'ADC Mode' >/dev/null 2>&1; then
			MIC_CARD=$card
			return 0
		fi
		card=$((card + 1))
	done
	return 1
}

read_mic_numid() {
	amixer -c "$MIC_CARD" cget numid="$1" 2>/dev/null |
		awk -F= '/: values=/{print $2; exit}' |
		tr -d '[:space:]\r'
}

set_mic_numid() {
	numid=$1
	name=$2
	value=$3
	if ! amixer -c "$MIC_CARD" cset numid="$numid" "$value" >/dev/null 2>&1; then
		MIC_FAILED=$((MIC_FAILED + 1))
		mic_log "设置 $name（numid $numid）为 '$value' 失败（card $MIC_CARD）"
		return 1
	fi
	actual=$(read_mic_numid "$numid")
	if [ "$actual" != "$value" ]; then
		MIC_FAILED=$((MIC_FAILED + 1))
		mic_log "$name（numid $numid）回读 '$actual'，期望 '$value'"
		return 1
	fi
	return 0
}

# RV1106 ACODEC 必须按这块板子的实际模拟电路配置。Echo-Mate 使用同一块板，
# 已验证的语音链路是：DiffadcL、右声道 Mute、MIC 12 dB、数字增益 211，并关闭
# 硬件 ALC AGC（软件侧 Speex 继续做降噪/AGC）。DAC 还必须在每次播放前强制
# 手动导通，否则 PCM 在正常工作但扬声器没有声音。
#
# 这里在核心打开 PCM 之前做一次幂等预检并逐项回读，避免 S25 开机脚本缺失时
# 静音、削顶或音量被重置却仍显示"音频正常"。
configure_mic() {
	command -v amixer >/dev/null 2>&1 || {
		mic_log "amixer 不可用，无法初始化麦克风"
		return 1
	}
	tries=0
	while [ "$tries" -lt 50 ]; do
		find_mic_card && break
		tries=$((tries + 1))
		usleep 100000 2>/dev/null || sleep 1
	done
	[ -n "$MIC_CARD" ] || {
		mic_log "找不到 ACODEC 混音控件，麦克风未初始化"
		return 1
	}

	MIC_FAILED=0
	set_mic_numid 20 'ADC MICBIAS Voltage' '7'
	set_mic_numid 21 'ADC Main MICBIAS' '1'
	# 与 Echo-Mate 的 S99start_echo_defconfig 保持一致。
	set_mic_numid 19 'ADC Mode' '0'
	set_mic_numid 22 'ADC MIC Left Switch' '0'
	set_mic_numid 23 'ADC MIC Right Switch' '1'
	set_mic_numid 2 'ADC MIC Left Gain' '3'
	set_mic_numid 3 'ADC MIC Right Gain' '3'
	set_mic_numid 4 'ADC ALC Left Volume' '16'
	set_mic_numid 5 'ADC ALC Right Volume' '16'
	set_mic_numid 15 'ALC AGC Left Switch' '0'
	set_mic_numid 16 'ALC AGC Right Switch' '0'
	set_mic_numid 8 'ADC HPF Cut-off' '1'
	set_mic_numid 6 'ADC Digital Left Volume' '211'
	set_mic_numid 7 'ADC Digital Right Volume' '211'
	# HPMIX 先给满，再强制打开 DAC。numid 稳定且 name 在部分 uClibc 镜像上
	# 会被 amixer 的控件匹配逻辑拒绝。
	set_mic_numid 24 'DAC LINEOUT Volume' '30'
	set_mic_numid 25 'DAC HPMIX Volume' '2'
	set_mic_numid 26 'DAC Control Manually' '2'

	if [ "$MIC_FAILED" -eq 0 ]; then
		mic_log "初始化并回读验证通过（card $MIC_CARD）"
		return 0
	fi
	mic_log "初始化完成，但有 $MIC_FAILED 项失败"
	return 1
}

# 与 configure_mic 使用同一组稳定的 numid，但把所有输入增益、MICBIAS 和
# 输出音量压到零。DAC Control Manually=Off 会关闭手动 DAC 通路。
configure_muted_audio() {
	command -v amixer >/dev/null 2>&1 || {
		mic_log "amixer 不可用，无法确认硬件静音"
		return 1
	}
	tries=0
	while [ "$tries" -lt 50 ]; do
		find_mic_card && break
		tries=$((tries + 1))
		usleep 100000 2>/dev/null || sleep 1
	done
	[ -n "$MIC_CARD" ] || {
		mic_log "找不到 ACODEC 混音控件，无法写静音"
		return 1
	}

	MIC_FAILED=0
	set_mic_numid 21 'ADC Main MICBIAS' '0'
	set_mic_numid 22 'ADC MIC Left Switch' '1'
	set_mic_numid 23 'ADC MIC Right Switch' '1'
	# 增益枚举的可用档位从 1 起；0 虽出现在 ALSA 描述里，写入会被驱动拒绝。
	set_mic_numid 2 'ADC MIC Left Gain' '1'
	set_mic_numid 3 'ADC MIC Right Gain' '1'
	set_mic_numid 4 'ADC ALC Left Volume' '0'
	set_mic_numid 5 'ADC ALC Right Volume' '0'
	set_mic_numid 6 'ADC Digital Left Volume' '0'
	set_mic_numid 7 'ADC Digital Right Volume' '0'
	set_mic_numid 9 'ALC AGC Left Volume' '0'
	set_mic_numid 10 'ALC AGC Right Volume' '0'
	set_mic_numid 15 'ALC AGC Left Switch' '0'
	set_mic_numid 16 'ALC AGC Right Switch' '0'
	set_mic_numid 24 'DAC LINEOUT Volume' '0'
	set_mic_numid 25 'DAC HPMIX Volume' '1'
	set_mic_numid 26 'DAC Control Manually' '1'

	if [ "$MIC_FAILED" -eq 0 ]; then
		mic_log "硬件静音已逐项回读确认（card $MIC_CARD，ALSA 与 KWS 均已禁用）"
		return 0
	fi
	mic_log "硬件静音完成，但有 $MIC_FAILED 项失败"
	return 1
}

# 厂商 rkwifi_server 在 /data/cfg 缺失时会拿 /etc 的 dummy 配置覆盖
# /data/wpa_supplicant.conf。启动早期先把持久配置原子同步到两处，让它即使抢先
# 启动也读到正确网络；后续由 qzdesk_screen 接管 supplicant。
sync_wifi_conf() {
	[ -f "$WIFI_CONF" ] || return 0
	if ! grep -q 'network[[:space:]]*=' "$WIFI_CONF" 2>/dev/null; then
		echo "qzdesk: Wi-Fi 配置缺少 network 块，未同步" >>"$LOG"
		return 1
	fi
	if ! mkdir -p /data/cfg 2>/dev/null; then
		echo "qzdesk: 无法创建 /data/cfg，Wi-Fi 配置未同步" >>"$LOG"
		return 1
	fi
	for target in /data/wpa_supplicant.conf /data/cfg/wpa_supplicant.conf; do
		tmp="$target.qzdesk.tmp"
		if cp -f "$WIFI_CONF" "$tmp" 2>/dev/null &&
		   chmod 600 "$tmp" 2>/dev/null &&
		   mv -f "$tmp" "$target" 2>/dev/null; then
			continue
		fi
		rm -f "$tmp" 2>/dev/null
		echo "qzdesk: 同步 Wi-Fi 配置到 $target 失败" >>"$LOG"
		return 1
	done
	chmod 600 "$WIFI_CONF" 2>/dev/null
	echo "qzdesk: 保存的 Wi-Fi 配置已同步" >>"$LOG"
}

# 首次启动（尤其是擦除 userdata 或新板子）时写入出厂 Wi-Fi。已有任意
# network 块就完全保留用户配置，绝不在后续升级时覆盖。
ensure_default_wifi_conf() {
	[ -r "$DEFAULT_WIFI_CONF" ] || return 0
	if [ -s "$WIFI_CONF" ] && grep -q '^[[:space:]]*network[[:space:]]*=' "$WIFI_CONF"; then
		return 0
	fi

	dir=${WIFI_CONF%/*}
	tmp="$WIFI_CONF.qzdesk.tmp"
	mkdir -p "$dir" 2>/dev/null || return 1
	if cp -f "$DEFAULT_WIFI_CONF" "$tmp" 2>/dev/null &&
	   chmod 600 "$tmp" 2>/dev/null &&
	   mv -f "$tmp" "$WIFI_CONF" 2>/dev/null; then
		echo "qzdesk: 已写入出厂 Wi-Fi 配置" >>"$LOG"
		return 0
	fi
	rm -f "$tmp" 2>/dev/null
	echo "qzdesk: 写取出厂 Wi-Fi 配置失败" >>"$LOG"
	return 1
}

# WiFi：这块板子是 RTL8723BS（SDIO WiFi+BT），驱动模块放在 /oem/usr/lib/wifi。
# 一定要在起界面之前加载好 —— 界面启动时会探测一次有没有无线网卡，好让无线页
# 一进去就是可用状态。模块不在就静默跳过（镜像是纯有线的也不受影响）。
# 只加载 cfg80211 + r8723bs：r8723bs 是 FullMAC SDIO 驱动，不走 mac80211
# （Echo-Mate 的 insmod_wifi.sh 也是这么做的），多加载 mac80211 纯属浪费时间。
load_wifi() {
	# 固件：驱动写死从 /lib/firmware 读，而 rootfs 里没有，随包放在 oem，
	# 这里开机补进去（rootfs 只读时拷不进去，驱动会 request_firmware 失败）。
	if [ -d "$FW_SRC" ] && [ ! -e /lib/firmware/rtlwifi/rtl8723bs_nic.bin ]; then
		mkdir -p /lib/firmware/rtlwifi /lib/firmware/rtlbt 2>/dev/null
		cp -f "$FW_SRC"/rtlwifi/* /lib/firmware/rtlwifi/ 2>/dev/null
		cp -f "$FW_SRC"/rtlbt/* /lib/firmware/rtlbt/ 2>/dev/null
	fi

	[ -d "$WIFI_KO" ] || return 0
	[ -e /sys/class/net/wlan0 ] && return 0
	for m in cfg80211 r8723bs; do
		[ -f "$WIFI_KO/$m.ko" ] || continue
		grep -q "^$m " /proc/modules 2>/dev/null && continue
		insmod "$WIFI_KO/$m.ko" >>"$LOG" 2>&1
	done
	# 固件加载要一点时间（SDIO 探测 + 下载 firmware）
	i=0
	while [ "$i" -lt 20 ]; do
		[ -e /sys/class/net/wlan0 ] && { echo "qzdesk: wlan0 就绪" >>"$LOG"; return 0; }
		usleep 100000 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	echo "qzdesk: 等 wlan0 超时（模块加载了但没出网卡？查 dmesg | grep -i 8723）" >>"$LOG"
}

# 相机（SC3336 + rkcif/rkisp）：模块同样没进镜像，随包放在 /oem/usr/lib/camera。
# 顺序是依赖顺序，不能换：rk_dvbm 是 ISP 的 buffer manager，sc3336 挂在 rkcif 上。
# 界面已经起来之后再加载（见 start），万一某个模块把显示打乱，至少界面画过一帧；
# 不想要相机（或它造成白屏）时，删掉 /oem/usr/lib/camera 或建一个 disable 文件即可。
#
# clr_unready_dev 是 Echo-Mate 的 insmod_ko.sh 里学的关键兜底：rkcif/rkisp 的
# 异步 notifier 在传感器还没挂上时会把设备标记为 unready 而不注册 /dev/videoN，
# 传感器后到就永远没有节点 —— 写 1 强制补注册（仅模块方式编译时有效，我们正是）。
load_camera() {
	[ -d "$CAM_KO" ] || return 0
	[ -e "$CAM_KO/disable" ] && { echo "qzdesk: 相机模块已禁用（$CAM_KO/disable）" >>"$LOG"; return 0; }
	# 顺序关键：video_rkcif 里打包着 mipi-csi2 桥驱动，它在 probe 时要求
	# csi2-dphy-hw 已经就绪，否则直接 -22 硬失败（不是延迟探测），桥就永远
	# 缺席，CIF 找不到远端传感器 —— 所以 dphy-hw/dphy 必须先于 rkcif 加载。
	for m in rk_dvbm phy-rockchip-csi2-dphy-hw phy-rockchip-csi2-dphy video_rkcif video_rkisp sc3336; do
		[ -f "$CAM_KO/$m.ko" ] || continue
		grep -q "^$m " /proc/modules 2>/dev/null && continue
		out=$(insmod "$CAM_KO/$m.ko" 2>&1)
		[ -n "$out" ] && echo "qzdesk: 相机模块 $m: $out" >>"$LOG"
	done
	echo 1 > /sys/module/video_rkcif/parameters/clr_unready_dev 2>/dev/null
	echo 1 > /sys/module/video_rkisp/parameters/clr_unready_dev 2>/dev/null
	# 传感器 probe（I2C 读 CHIP_ID）+ MIPI 链路建立要一点时间，等节点出现
	i=0
	while [ "$i" -lt 30 ]; do
		ls /dev/video* >/dev/null 2>&1 && { echo "qzdesk: 相机节点 $(ls /dev/video* | tr '\n' ' ')" >>"$LOG"; return 0; }
		usleep 100000 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	echo "qzdesk: 等 /dev/video* 超时（查 dmesg | grep -iE 'sc3336|rkisp|rkcif'）" >>"$LOG"
}

wait_ready() {
	i=0
	while [ "$i" -lt "$READY_WAIT" ]; do
		ready && return 0
		usleep 100000 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	ready
}

# 本地唤醒词：独立进程（Rockchip NPU KWS，唤醒词 "小和小和"）。
#
# 它绑定一个 Unix socket，等核心把采集到的 PCM 旁路过来（核心侧见 audio/kws_tap.rs）；
# 命中唤醒词就往核心的 UDP 口发 {"type":"listen","state":"start"}，核心随即进入
# Listening —— 后面就是原本的语音链路，这个进程不参与说话，只负责"叫人"。
kws_supervisor() {
	echo $$ >"$KWS_SUPERVISOR_PIDFILE"
	child=
	stopping=0
	trap 'stopping=1; [ -n "$child" ] && kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; rm -f "$KWS_PIDFILE" "$KWS_SOCK" "$KWS_SUPERVISOR_PIDFILE"; exit 0' TERM INT
	# adb shell 退出时会给它的作业发 HUP；supervisor 已经脱离会话，
	# 只有明确的 TERM/INT 才应该结束它。
	trap '' HUP
	while [ "$stopping" -eq 0 ]; do
		rm -f "$KWS_SOCK"
		LD_LIBRARY_PATH=/oem/usr/lib "$KWS_BIN" >>"$LOG" 2>&1 &
		child=$!
		echo "$child" >"$KWS_PIDFILE"
		wait "$child"
		status=$?
		rm -f "$KWS_PIDFILE" "$KWS_SOCK"
		[ "$stopping" -eq 1 ] && break
		echo "qzdesk: 唤醒词进程退出（status=$status），2 秒后重启" >>"$LOG"
		sleep 2
	done
}

start_kws() {
	audio_disabled && return 0
	[ -x "$KWS_BIN" ] || return 0
	# 唤醒库按 mode 各自命名装在 lib/qzdesk/（进程自己 dlopen，不链接），所以这里只需
	# 确认要用的那一套在。目录不在 = 这版固件没编唤醒，静默跳过。
	[ -f "/oem/usr/lib/qzdesk/libaec_bf_process_${QZDESK_KWS_MODE:-mode2}.so" ] || return 0
	if [ -f "$KWS_SUPERVISOR_PIDFILE" ]; then
		supervisor=$(cat "$KWS_SUPERVISOR_PIDFILE" 2>/dev/null)
		[ -n "$supervisor" ] && kill -0 "$supervisor" 2>/dev/null && return 0
	fi
	rm -f "$KWS_SOCK" "$KWS_PIDFILE" "$KWS_SUPERVISOR_PIDFILE"
	# LD_LIBRARY_PATH 要给的是**库自己的依赖**（librknnmrt.so / librkaudio_common.so 在
	# /oem/usr/lib），不是唤醒库本身 —— 它是 dlopen 指定完整路径加载的。
	if command -v setsid >/dev/null 2>&1; then
		# BusyBox setsid 没有 -f。让一个短命的中间 shell 进入新会话，
		# 再把真正的 supervisor 放到它后面并立即退出，避免 adb shell
		# 在命令结束时收走同一个作业组里的后台进程。
		setsid sh -c 'nohup "$0" kws-supervise >>"$1" 2>&1 </dev/null &' \
			"$0" "$LOG" </dev/null >>"$LOG" 2>&1
	else
		nohup "$0" kws-supervise >>"$LOG" 2>&1 </dev/null &
	fi
	# PID 由 supervisor 自己写。这里再写 $! 会覆盖成中间 shell 的 PID，
	# 下一次检查就会误判进程已退出。
	i=0
	while [ "$i" -lt 20 ]; do
		supervisor=$(cat "$KWS_SUPERVISOR_PIDFILE" 2>/dev/null)
		if [ -n "$supervisor" ] && kill -0 "$supervisor" 2>/dev/null; then
			echo "qzdesk: 唤醒词监督进程已启动（pid $supervisor，模式 ${QZDESK_KWS_MODE:-mode2}），日志 $LOG"
			return 0
		fi
		usleep 100000 2>/dev/null || sleep 1
		i=$((i + 1))
	done
	echo "qzdesk: 唤醒词监督进程启动失败（检查 $LOG）" >>"$LOG"
	return 1
}

start() {
	mkdir -p /var/log /var/run
	ensure_default_wifi_conf
	sync_wifi_conf
	if running; then
		echo "qzdesk: 已在运行（pid ${pid:-?}），检查唤醒词进程"
		start_kws
		return 0
	fi
	wait_ready || echo "qzdesk: 就绪等待超时，仍尝试启动（显示节点或字体可能还没到）"
	[ -x "$DAEMON" ] || { echo "qzdesk: 找不到 $DAEMON"; return 1; }
	[ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt "$LOG_MAX" ] && : >"$LOG"
	cd "$WORKDIR" || return 1
	# 开机耗时基线：这里记一条 uptime，界面出图时自己再记一条，相减就是启动耗时
	echo "qzdesk: 启动 uptime=$(cut -d' ' -f1 /proc/uptime)" >>"$LOG"
	if audio_disabled; then
		configure_muted_audio || echo "qzdesk: 硬件静音未完全通过，继续以无 ALSA 模式启动（详情见 $LOG）" >>"$LOG"
	else
		configure_mic || echo "qzdesk: 麦克风混音预检未完全通过，继续启动（详情见 $LOG）" >>"$LOG"
	fi
	load_wifi
	sync_wifi_conf
	# 从 adb shell 里手动 start 时，界面会跟着调用者的会话一起被清掉（终端
	# 挂断发 SIGHUP），表现是"部署后跑一两分钟屏幕就没了"。开机路径本来
	# 没有这个父会话，但两种入口都用 setsid 起，行为一致。
	if command -v setsid >/dev/null 2>&1; then
		setsid "$DAEMON" >>"$LOG" 2>&1 &
	else
		"$DAEMON" >>"$LOG" 2>&1 &
	fi
	echo $! > "$PIDFILE"
	echo "qzdesk: 已启动（pid $(cat $PIDFILE)），日志 $LOG"
	start_kws
	# 界面先跑起来，再挂相机模块（相机初始化比较重，别挡住第一帧）
	load_camera
}

stop() {
	if [ -f "$KWS_SUPERVISOR_PIDFILE" ]; then
		pid=$(cat "$KWS_SUPERVISOR_PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		rm -f "$KWS_SUPERVISOR_PIDFILE"
	fi
	if [ -f "$KWS_PIDFILE" ]; then
		pid=$(cat "$KWS_PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		rm -f "$KWS_PIDFILE"
	fi
	if [ -f "$PIDFILE" ]; then
		pid=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	killall qzdesk_screen 2>/dev/null
	killall qzdesk-kws 2>/dev/null
	rm -f "$KWS_SOCK"
	echo "qzdesk: 已停止"
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	status)  running && echo "qzdesk: 运行中（pid $pid）" || echo "qzdesk: 未运行" ;;
	kws-supervise) kws_supervisor ;;
	*)       echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
